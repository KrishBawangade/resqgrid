# ResQGrid Citizen Portal - Environment Configuration
# Copy this file to .env.local and populate the values

# 1. Google Gemini AI Key (for Situation Note Triage & Vulnerability Extraction)
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"

# 2. Neon Serverless PostgreSQL Database URL
# Get this from your Neon Console (https://console.neon.tech)
# Pooled connection string (recommended for Next.js Serverless):
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Direct connection string (optional, for Prisma migrations):
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 3. Production Portal Endpoints
NEXT_PUBLIC_COORDINATOR_URL="https://resqgrid-main.vercel.app"
NEXT_PUBLIC_CITIZEN_URL="https://resqgrid-citizen.vercel.app"
COORDINATOR_URL="https://resqgrid-main.vercel.app"
